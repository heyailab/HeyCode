# HeyCode 后端配置模板
#
# 使用方法：
#   1. cp deploy/.env.example deploy/.env
#   2. 生成生产密钥：openssl rand -hex 32
#   3. 填入下方 MASTER_KEY
#   4. 执行 deploy/deploy.sh <user@host> 上传

# HTTP 端口（默认 8787）
PORT=8787

# SQLite DSN（默认本地文件，生产建议绝对路径）
DATABASE_URL=file:/opt/heycode/data.db

# 主密钥：32 字节的 hex 字符串（64 字符）
# 生产环境必须替换占位符，否则加密数据重启后失效
# 生成命令：openssl rand -hex 32
MASTER_KEY=replace_me_with_32_bytes_hex_string

# JWT 密钥（保留字段，未来扩展用，min 8 字符）
JWT_SECRET=change_me_min_8_chars

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# Mock CLI 模式：true 时 claude-code 走 MockAdapter，无需真实 SSH/CLI
# 仅用于本地开发调试，生产环境必须为 false
MOCK_CLI=false
